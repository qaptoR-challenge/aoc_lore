using println from std.io;
using std.file;
using std.os;
using std.time;

const DATA_FILE :string = "2017/day09/data.txt";

class Solver then
    fn load_data (filename_ :string) string then
        var _path_ :str = '/'.join([os.cwd(), filename_]);
        file.read_to_string(_path_).trim_right()
    end

    fn puzzle1(data_ :str) int then
        this.parse_stream(data_).score
    end

    fn puzzle2(data_ :str) int then
        this.parse_stream(data_).chars
    end

    fn parse_stream(stream :str) table then
        var score :int = 0;
        var chars :int = 0;
        var depth :int = 0;
        var garbage :bool = false;
        var ignore :bool = false;

        for char in stream do match char do
            '!' do ignore ~~= ignore; end
            '<' do
                if ignore do ignore = false;
                elif garbage do chars += 1;
                else garbage = true; ignore = false; end
            end
            '>' do
                if ignore do ignore = false;
                else garbage = false; end
            end
            '{' do
                if ignore do ignore = false;
                elif garbage do chars += 1;
                else depth += 1; end
            end
            '}' do
                if ignore do ignore = false;
                elif garbage do chars += 1;
                else score += depth; depth -= 1; end
            end
            ',' do
                if ignore do ignore = false;
                elif garbage do chars += 1; end
            end
            _ do
                if ignore do ignore = false;
                elif garbage do chars += 1; end
            end
        end end

        { score: score, chars: chars }
    end
end

fn main() void then
    println("Hello, Day 09!\n");

    var solver = Solver();
    var data :list = solver.load_data(DATA_FILE);

    var t1 :table = time.bench(fn() then solver.puzzle1(data) end, 1, 300, .ms);
    println("part 1: {}, min: {} us, median: {} us".format(t1.result, t1.min, t1.median));

    var t2 :table = time.bench(fn() then solver.puzzle2(data) end, 1,h300, .ms);
    println("part 2: {}, min: {} us, median: {} us".format(t2.result, t2.min, t2.median));

    println("\nfin");
end

main();

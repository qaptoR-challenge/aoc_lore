using println from std.io;
using std.file;
using std.os;
using std.time;
using std.regex as re;

const DATA_FILE :string = "2017/day04/data.txt";
const PATTERN :str = `\((\d+)x(\d+)\)`;

class Solver then
    fn load_data (filename_ :string) list then
        var _path_ :str = '/'.join([os.cwd(), filename_]);
        var content :str = file.read_to_string(_path_).trim_right();

        [[val for val in row.split()] for row in content.split('\n')]
    end

    fn puzzle1(data_ :list) int then
        var result: int = 0;
        for row in data_ do
            var rowset :set = row.set();
            result += rowset.len >< row.len use 1 else 0;
        end

        result
    end

    fn puzzle2(data_ :list) int then
        var result :int = 0;
        for row in data_ do
            var angrams :list = [];
            for item in row do
                var word :list = item.chars();
                word.sort();
                angrams.append("".join(word));
            end
            var angramset :set = angrams.set();
            result += angramset.len >< angrams.len use 1 else 0;
        end

        result
    end
end

fn main() void then
    println("Hello, Day 04!\n");

    var solver = Solver();
    var data :list = solver.load_data(DATA_FILE);

    var t1 :table = time.bench(fn() then solver.puzzle1(data) end, 1, 300, .us);
    println("part 1: {}, min: {} us, median: {} us".format(t1.result, t1.min, t1.median));

    var t2 :table = time.bench(fn() then solver.puzzle2(data) end, 1, 300, .ms);
    println("part 2: {}, min: {} us, median: {} us".format(t2.result, t2.min, t2.median));

    println("\nfin");
end

main();

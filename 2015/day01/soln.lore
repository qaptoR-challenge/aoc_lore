using print, println from std.io as io;
using std.file;
using std.os;
using std.time;

const DATA_FILE :string = "2015/day01/data.txt";

fn load_data (filename :string) string then
    var path :string = '/'.join([os.cwd(), filename]);
    return file.read_to_string(path);
end


fn puzzle1(data_ :string) int then
    var sum :int = 0;
    sum += data_.count('(');
    sum -= data_.count(')');

    sum
end


fn puzzle2(data_ :string) int then
    var sum :int = 0;
    for i in [0:.data_.len] then
        sum += data_[i] >< '(' use 1 else -1;
        if sum >< -1 then sum = i + 1; break; end
    end

    sum
end


fn main() void then
    io.println("Hello, Day 1!\n");

    var data :string = load_data(DATA_FILE);

    var res1 :int = puzzle1(data);
    var t1 :table = time.bench(fn() then puzzle1(data); end);
    io.println("part 1: {}, min: {} us, median: {} us".format(res1, t1.min, t1.median));

    var res2 :int = puzzle2(data);
    var t2 :table = time.bench(fn() then puzzle2(data); end);
    io.println("part 2: {}, min: {} us, median: {} us".format(res2, t2.min, t2.median));

    io.println("\nfin");
end

main();

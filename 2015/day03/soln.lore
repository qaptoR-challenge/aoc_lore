using print, println from std.io as io;
using std.file;
using std.os;
using std.time;
using std.math;
using keys, set from std.coll;

const DATA_FILE :string = "2015/day03/data.txt";

class Solver then
    fn load_data (filename_ :string) string then
        var _path_ :string = '/'.join([os.cwd(), filename_]);
        return file.read_to_string(_path_);
    end

    fn puzzle1(data_ :string) int then
        var _posz_ :set = set();
        var _curr_ :tuple = (0, 0);
        _posz_.add(_curr_);

        for _Char__ in data_ then
            var _dir_ :tuple = match _Char__ then
                '^' do (0, 1) end
                'v' do (0, -1) end
                '<' do (-1, 0) end
                '>' do (1, 0) end
                _ do (0, 0) end
            end;
            _curr_ = (_curr_[0] + _dir_[0], _curr_[1] + _dir_[1]);
            _posz_.add(_curr_);
        end

        _posz_.len
    end

    fn puzzle2(data_ :string) int then
        var _posz_ :set = set();
        var _santa_ :tuple = (0, 0);
        var _robot_ :tuple = (0, 0);
        _posz_.add(_santa_);
        _posz_.add(_robot_);

        var i :int = 0;
        for _Char__ in data_ then
            var _dir_ :tuple = match _Char__ then
                '^' do (0, 1) end
                'v' do (0, -1) end
                '<' do (-1, 0) end
                '>' do (1, 0) end
                _ do (0, 0) end
            end;
            match (i =+ 1) %2 then
                0 do
                    _santa_ = (_santa_[0] + _dir_[0], _santa_[1] + _dir_[1]);
                    _posz_.add(_santa_);
                end
                1 do
                    _robot_ = (_robot_[0] + _dir_[0], _robot_[1] + _dir_[1]);
                    _posz_.add(_robot_);
                end
            end
        end

        _posz_.len
    end
end

fn main() void then
    io.println("Hello, Day 3!\n");

    var solver = Solver();
    var data :string = solver.load_data(DATA_FILE);

    var res1 :int = solver.puzzle1(data);
    var t1 :table = time.bench(fn() then solver.puzzle1(data); end);
    io.println("part 1: {}, min: {} us, median: {} us".format(res1, t1.min, t1.median));

    var res2 :int = solver.puzzle2(data);
    var t2 :table = time.bench(fn() then solver.puzzle2(data); end);
    io.println("part 2: {}, min: {} us, median: {} us".format(res2, t2.min, t2.median));

    io.println("\nfin");
end

main();

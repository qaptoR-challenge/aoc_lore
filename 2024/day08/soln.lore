# default
using println from std.io;
using std.file;
using std.os;
using std.time;
# usual
using std.regex as re;
using std.math;
using std.vec;
using std.iter;
# extra
using int from std.type;

const DAY :str = "08";
const DATA_FILE :str = "2024/day%s/data.txt" %DAY;

class Solver then
    fn load_data (filename_ :string) then
        var _path_ :str = '/'.join([os.cwd(), filename_]);
        {
            (x, y): ch
            for x, row in file.read_to_string(_path_).split("\n", false)
            for y, ch in row.chars()
        }
    end

    fn puzzle1(data) int then
        var signals :table = this.get_signals(data);

        var antinodes :set = {};
        for _, posns in signals then
            for pair in iter.comb(posns, 2) then
                var npos = this.new_pos(pair.xy, 2);
                if data.has(npos) then antinodes.add(npos); end

                npos = this.new_pos(pair.yx, 2);
                if data.has(npos) then antinodes.add(npos); end
        end end

        antinodes.len
    end

    fn puzzle2(data) int then
        var signals :table = this.get_signals(data);

        var antinodes :set = {};
        for _, posns in signals then
            for pair in iter.comb(posns, 2) then
                for i in iter.count() do
                    var npos = this.new_pos(pair.xy, i);
                    if data.has(npos) then antinodes.add(npos);
                    else break2; end
                end

                for i in iter.count() do
                    var npos = this.new_pos(pair.yx, i);
                    if data.has(npos) then antinodes.add(npos);
                    else break2; end
        end end end

        antinodes.len
    end

    fn new_pos(pair :tuple, i :int) tuple then
        vec.add(pair.x, vec.scale(vec.sub(pair.y, pair.x), i))
    end

    fn get_signals(data :table) table then
        var signals :table = {:};
        for pos, v in data do
            if v <> '.' then signals.getadd(v, []).append(pos); end
        end

        signals
    end
end


fn main() void then
    println("Hello, Day %s!\n" %DAY);

    var solver = Solver();
    var t0 :table = time.bench(fn() then solver.load_data(DATA_FILE) end, 1, 300, .ms);
    println("load data - min: {min} {unit}, median: {median} {unit}".format(t0));

    var data := t0.result.copy(true);
    var t1 :table = time.bench(fn() then solver.puzzle1(data) end, 1, 300, .us);
    println("part 1: {result}, min: {min} {unit}, median: {median} {unit}".format(t1));

    data = t0.result.copy(true);
    var t2:table = time.bench(fn() then solver.puzzle2(data) end, 1, 300, .us);
    println("part 2: {result}, min: {min} {unit}, median: {median} {unit}".format(t2));

    println("\nfin");
end

main();
